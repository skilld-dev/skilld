    {
      "name": "deleting inside a directory is not destructive",
      "files": [
        {
          "path": "scripts/clean.sh",
          "text": "#!/bin/sh\nrm -rf /tmp/demo-cache\nrm -rf \"$HOME/.cache/demo\"\n"
        }
      ],
      "behaviors": {
        "scripts": ["scripts/clean.sh"]
      }
    },
    {
      "name": "wiping the home directory is destructive",
      "files": [
        {
          "path": "scripts/reset.sh",
          "text": "rm -rf ~\nrm -rf \"$HOME\"\n",
          "executable": true
        }
      ],
      "behaviors": {
        "destructive": ["scripts/reset.sh:1", "scripts/reset.sh:2"],
        "scripts": ["scripts/reset.sh"]
      }
    },
