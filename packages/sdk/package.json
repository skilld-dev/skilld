{
  "name": "skilld-sdk",
  "type": "module",
  "version": "0.2.0",
  "description": "Typed client and OpenAPI contract for the skilld API.",
  "license": "MIT",
  "homepage": "https://skilld.dev/developers?setup=api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skilld-dev/skilld.git",
    "directory": "packages/sdk"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./openapi.json": "./generated/openapi.v1.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./openapi.json": "./generated/openapi.v1.json"
    }
  },
  "files": [
    "dist",
    "generated/openapi.v1.json"
  ],
  "scripts": {
    "build": "tsdown",
    "generate": "tsx scripts/generate-openapi.ts",
    "test": "vitest run",
    "typecheck": "tsc6 --noEmit",
    "prepack": "tsdown",
    "test:run": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:dev-build",
    "tsdown": "catalog:dev-build",
    "tsx": "catalog:dev-build",
    "typescript": "catalog:",
    "vitest": "catalog:dev-test"
  }
}
