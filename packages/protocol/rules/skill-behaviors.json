        ["uv", "tool", "install"],
        ["uvx"],
        ["brew", "install"],
        ["cargo", "install"],
        ["cargo", "add"],
        ["go", "install"],
        ["go", "get"],
        ["gem", "install"],
        ["apt", "install"],
        ["apt-get", "install"],
        ["choco", "install"],
        ["winget", "install"]
      ]
    },
    {
      "id": "network",
