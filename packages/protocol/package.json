{
  "name": "skilld-protocol",
  "type": "module",
  "version": "2.4.0",
  "description": "Wire shapes and constants shared between the skilld CLI and skilld.dev",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skilld-dev/skilld.git",
    "directory": "packages/protocol"
  },
  "keywords": [
    "skilld",
    "protocol",
    "zod",
    "schema"
  ],
  "sideEffects": false,
  "exports": {
    "./v1": {
      "types": "./dist/v1.d.mts",
      "import": "./dist/v1.mjs"
    },
    "./openapi/skilld-v1.yaml": "./openapi/skilld-v1.yaml",
    "./wire": {
      "types": "./dist/wire.d.mts",
      "import": "./dist/wire.mjs"
    },
    "./constants": {
      "types": "./dist/constants.d.mts",
      "import": "./dist/constants.mjs"
    },
    "./test-fixtures": {
      "types": "./dist/test-fixtures.d.mts",
      "import": "./dist/test-fixtures.mjs"
    }
  },
  "files": [
    "dist",
    "openapi"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm generate:v1 && obuild",
    "generate:v1": "openapi-typescript ./openapi/skilld-v1.yaml --output ./src/generated/skilld-v1.ts --alphabetize",
    "lint:v1": "redocly lint ./openapi/skilld-v1.yaml",
    "check:v1": "pnpm generate:v1 && git diff --exit-code -- ./src/generated/skilld-v1.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "publint": "publint",
    "attw": "pnpm pack && attw skilld-protocol-*.tgz --ignore-rules no-resolution cjs-resolves-to-esm && rm skilld-protocol-*.tgz",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev-lint",
    "@arethetypeswrong/cli": "catalog:",
    "@redocly/cli": "catalog:",
    "@types/node": "catalog:dev-build",
    "@typescript/native": "catalog:",
    "eslint": "catalog:dev-lint",
    "obuild": "catalog:dev-build",
    "openapi-typescript": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:dev-test"
  }
}
